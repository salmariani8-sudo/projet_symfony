{% extends 'base.html.twig' %}
{% block title %}Lieux — EventSpot{% endblock %}

{% block body %}

<div class="es-page-header">
    <div class="container">
        <h1><i class="bi bi-geo-alt"></i> Lieux</h1>
        <p>Tous les lieux disponibles sur EventSpot</p>
    </div>
</div>

<section class="es-section">
<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted mb-0"><strong>{{ lieux|length }}</strong> lieu(x) enregistré(s)</p>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_lieu_new') }}" class="buy-btn">
                <i class="bi bi-plus-circle"></i> Nouveau lieu
            </a>
        {% endif %}
    </div>

    <div class="row gy-4">
        {% for lieu in lieux %}
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ loop.index * 50 }}">
            <div class="es-card card h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div style="width:50px; height:50px; background:var(--accent-color,#f82249); border-radius:50%; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-building text-white fs-5"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">{{ lieu.nom }}</h5>
                            <small class="text-muted">{{ lieu.ville }}</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-2">
                        <i class="bi bi-geo-alt"></i> {{ lieu.adresse }}
                    </p>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-people"></i> Capacité : <strong>{{ lieu.capacite }}</strong> personnes
                    </p>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-geo-alt fs-1 d-block mb-2"></i>
            Aucun lieu enregistré.
        </div>
        {% endfor %}
    </div>

</div>
</section>

{% endblock %}
