{% extends 'base.html.twig' %}
{% block title %}Récemment consultés — EventSpot{% endblock %}

{% block body %}

<div class="es-page-header">
    <div class="container">
        <h1><i class="bi bi-clock-history"></i> Récemment consultés</h1>
        <p>Vos derniers événements consultés</p>
    </div>
</div>

<section class="es-section">
<div class="container">
    <div class="row gy-4">
        {% for e in evenements %}
        <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
            <div class="es-card card h-100">
                {% if e.imageName %}
                    <img src="{{ asset('uploads/evenements/' ~ e.imageName) }}"
                         class="es-card-img" alt="{{ e.titre }}">
                {% else %}
                    <div class="es-placeholder">
                        {% if e.categorie == 'concert' %}🎵
                        {% elseif e.categorie == 'conference' %}🎤
                        {% elseif e.categorie == 'atelier' %}🔧
                        {% elseif e.categorie == 'meetup' %}👥
                        {% else %}📚{% endif %}
                    </div>
                {% endif %}
                <div class="card-body p-4">
                    <h5 class="fw-bold">{{ e.titre }}</h5>
                    <p class="text-muted small mb-1">
                        <i class="bi bi-calendar3"></i> {{ e.dateDebut ? e.dateDebut|date('d/m/Y') : '-' }}
                    </p>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-geo-alt"></i> {{ e.lieu ? e.lieu.ville : '-' }}
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-4 px-4">
                    <a href="{{ path('app_evenement_show', {id: e.id}) }}"
                       class="buy-btn d-block text-center w-100">
                        Revoir l'événement
                    </a>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-clock fs-1 d-block mb-2"></i>
            Vous n'avez consulté aucun événement récemment.
            <br>
            <a href="{{ path('app_evenement_index') }}" class="buy-btn mt-3 d-inline-block">
                Parcourir les événements
            </a>
        </div>
        {% endfor %}
    </div>
</div>
</section>

{% endblock %}
