{% extends 'base.html.twig' %}
{% block title %}Nouvel événement — EventSpot{% endblock %}

{% block body %}

<div class="es-page-header">
    <div class="container">
        <h1><i class="bi bi-plus-circle"></i> Créer un événement</h1>
    </div>
</div>

<section class="es-section">
<div class="container">
<div class="row justify-content-center">
<div class="col-lg-8" data-aos="fade-up">
    <div class="es-card card">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4" style="border-bottom:2px solid var(--accent-color,#f82249); padding-bottom:10px;">
                Informations de l'événement
            </h4>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            {{ form_row(form.titre) }}
            {{ form_row(form.description) }}

            <div class="row">
                <div class="col-md-6">{{ form_row(form.dateDebut) }}</div>
                <div class="col-md-6">{{ form_row(form.dateFin) }}</div>
            </div>

            {{ form_row(form.lieu) }}

            <div class="row">
                <div class="col-md-6">{{ form_row(form.categorie) }}</div>
                <div class="col-md-6">{{ form_row(form.statut) }}</div>
            </div>

            <div class="row">
                <div class="col-md-6">{{ form_row(form.capaciteMax) }}</div>
                <div class="col-md-6">{{ form_row(form.prix) }}</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tags</label>
                {{ form_widget(form.tags) }}
            </div>

            {{ form_row(form.imageFile) }}

            <div class="mt-4">
                <button type="submit" class="buy-btn w-100" style="padding:14px;">
                    <i class="bi bi-check-circle"></i> Créer l'événement
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
</div>
</div>
</section>

{% endblock %}
