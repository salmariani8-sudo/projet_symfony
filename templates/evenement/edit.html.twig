{% extends 'base.html.twig' %}
{% block title %}Modifier — {{ evenement.titre }}{% endblock %}

{% block body %}

<div class="es-page-header">
    <div class="container">
        <h1><i class="bi bi-pencil"></i> Modifier l'événement</h1>
        <p>{{ evenement.titre }}</p>
    </div>
</div>

<section class="es-section">
<div class="container">
<div class="row justify-content-center">
<div class="col-lg-8" data-aos="fade-up">
    <div class="es-card card">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4" style="border-bottom:2px solid #ffc107; padding-bottom:10px;">
                ✏️ Modifier : {{ evenement.titre }}
            </h4>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            {{ form_row(form.titre) }}
            {{ form_row(form.description) }}

            <div class="row">
                <div class="col-md-6">{{ form_row(form.dateDebut) }}</div>
                <div class="col-md-6">{{ form_row(form.dateFin) }}</div>
            </div>

            {{ form_row(form.lieu) }}

            <div class="row">
                <div class="col-md-6">{{ form_row(form.categorie) }}</div>
                <div class="col-md-6">{{ form_row(form.statut) }}</div>
            </div>

            <div class="row">
                <div class="col-md-6">{{ form_row(form.capaciteMax) }}</div>
                <div class="col-md-6">{{ form_row(form.prix) }}</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tags</label>
                {{ form_widget(form.tags) }}
            </div>

            {% if evenement.imageName %}
                <div class="mb-3">
                    <label class="form-label fw-semibold">Image actuelle</label><br>
                    <img src="{{ asset('uploads/evenements/' ~ evenement.imageName) }}"
                         style="max-height:150px; border-radius:8px; border:2px solid #dee2e6;" alt="Image actuelle">
                    <p class="text-muted small mt-1">Choisir un nouveau fichier remplacera l'image ci-dessus.</p>
                </div>
            {% endif %}

            {{ form_row(form.imageFile) }}

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning flex-fill" style="padding:12px; font-weight:600;">
                    <i class="bi bi-check-circle"></i> Enregistrer les modifications
                </button>
                <a href="{{ path('app_evenement_show', {id: evenement.id}) }}"
                   class="btn btn-outline-secondary flex-fill" style="padding:12px;">
                    Annuler
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
</div>
</div>
</section>

{% endblock %}
